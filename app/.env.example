# Copy this file to ".env" and fill in your Supabase project values.
# Find them in Supabase → Project Settings → API.
# (The anon key is safe to expose in a frontend app.)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only (powers JAM Intelligence and the coaching/brief endpoints).
# NOT prefixed with VITE_ so it stays secret and is never sent to the browser.
OPENAI_API_KEY=your-openai-project-key
# Optional model override. Defaults to the current flagship used by JAM HQ.
OPENAI_MODEL=gpt-5.6-sol
